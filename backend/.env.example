# ===================================================================
# X-RAY SQUARED — Backend environment configuration
# ===================================================================
# Copy to `.env` for local development.
# On Render: enter these in Dashboard -> Environment (never upload .env).
# Values below are PRODUCTION DEFAULTS / PLACEHOLDERS only. No secrets.
# ===================================================================

# ---------- Model ----------
# Existing trained S_RAY Keras model. Relative paths resolve against backend/.
MODEL_PATH=models/S_RAY_Pneumonia_Model.keras
# X-ray gate model (rejects non-chest-X-ray uploads).
GATE_MODEL_PATH=models/S_RAY_Xray_Gate.keras
# S_RAY config (thresholds / classes / input size).
CONFIG_PATH=s_ray_config.json
# MUST stay "torch" — the .keras models run on the Keras 3 PyTorch backend.
KERAS_BACKEND=torch

# ---------- Database ----------
# Local default (SQLite file inside backend/):
DATABASE_URL=sqlite:///./xray_squared.db
# Render production (persistent — Render erases the disk on every redeploy):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# ---------- Directories ----------
UPLOAD_DIR=uploads
RESULT_DIR=results

# ---------- Server ----------
# Render injects PORT automatically. Never hardcode it.
HOST=0.0.0.0
PORT=8000

# ---------- CORS ----------
# Local development frontends:
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Production — replace with your deployed Vercel origin (no trailing slash):
# CORS_ORIGINS=https://your-project.vercel.app
# Additional origins (preview deploys) go here, comma separated:
# CORS_ORIGINS=https://your-project.vercel.app,https://your-project-git-main-you.vercel.app
# Regex for any https://*.vercel.app preview host. Set empty to disable.
CORS_ALLOW_ORIGIN_REGEX=https://.*\.vercel\.app
# NEVER set this in production.
CORS_ALLOW_ALL=false

# ---------- Confidence thresholds (prototype, NOT clinically calibrated) ----------
HIGH_CONFIDENCE_THRESHOLD=0.80
MEDIUM_CONFIDENCE_THRESHOLD=0.60

# ---------- Uploads ----------
MAX_UPLOAD_MB=10

# ---------- Image quality heuristics (prototype, NOT clinically calibrated) ----------
BLUR_THRESHOLD_POOR=30.0
BLUR_THRESHOLD_WARNING=100.0