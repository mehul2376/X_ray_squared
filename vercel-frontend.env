# ===================================================================
# X-RAY SQUARED — Vercel frontend environment
# ===================================================================
# Add these in Vercel Dashboard -> Project -> Settings -> Environment Variables.
# Set them for BOTH Production and Preview.
#
# No secrets. NEXT_PUBLIC_* values are inlined into the client bundle at build
# time, so never place a private key, HF token or database URL here.
# ===================================================================

# Base URL of the deployed Render FastAPI backend. No trailing slash.
NEXT_PUBLIC_API_URL=https://YOUR-RENDER-DOMAIN.onrender.com

# Production must never fall back to synthetic demo data.
# Set to false for production, true only for local UI work.
NEXT_PUBLIC_ALLOW_MOCK_DATA=false