# X-RAY SQUARED — Render backend environment (Backend Web Service)
#
# Enter these in Render Dashboard -> your service -> Environment.
# Or use render.yaml (Blueprint) which covers the same keys.
# No secrets in this file. Placeholders only.

# --- Model (existing trained model, shipped in the repository) ---
MODEL_PATH=models/S_RAY_Pneumonia_Model.keras
GATE_MODEL_PATH=models/S_RAY_Xray_Gate.keras
CONFIG_PATH=s_ray_config.json
KERAS_BACKEND=torch
PYTHON_VERSION=3.12.8

# --- Database ---
# SQLite on Render's filesystem is ERASED on every redeploy.
# Recommended for production: create a Render Postgres instance and put its
# internal/external URL here, e.g.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./xray_squared.db

# --- Directories ---
UPLOAD_DIR=uploads
RESULT_DIR=results

# --- CORS ---
# REQUIRED: your deployed Vercel production origin, no trailing slash.
CORS_ORIGINS=https://YOUR-VERCEL-DOMAIN.vercel.app
CORS_ALLOW_ORIGIN_REGEX=https://.*\.vercel\.app
CORS_ALLOW_ALL=false

# --- Thresholds (prototype, NOT clinically calibrated) ---
HIGH_CONFIDENCE_THRESHOLD=0.80
MEDIUM_CONFIDENCE_THRESHOLD=0.60

# --- Uploads ---
MAX_UPLOAD_MB=10

# --- Server ---
# PORT is injected by Render. Do not set it manually.
HOST=0.0.0.0